NODE_ENV=localprod
PORT=3000

# DB
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=ecommerce
DB_LOGGING=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Event bus
EVENT_BUS_DRIVER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ecommerce

# Auth
JWT_SECRET=<min 16 chars, usar openssl rand -hex 32>
JWT_EXPIRES_IN=1d

# Payments
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=<real>
PAYMENT_TIMEOUT_MS=5000
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_BASE_MS=500
PAYMENT_RETRY_MAX_MS=4000
PAYMENT_CB_THRESHOLD=5
PAYMENT_CB_RESET_MS=30000
PAYMENT_BH_MAX_CONCURRENT=10
PAYMENT_BH_MAX_QUEUE=20
PAYMENT_BH_QUEUE_TIMEOUT_MS=5000


# Logs
LOG_LEVEL=info
SERVICE_NAME=ecommerce-api

# Reconciliation
RECONCILIATION_ENABLED=true
RECONCILIATION_WINDOW_MINUTES=60
RECONCILIATION_BATCH_SIZE=50
