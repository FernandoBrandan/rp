{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22", "pnpm": ">=9" },
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "NODE_ENV=dev nest start --watch",
    "start:localprod": "NODE_ENV=localprod node dist/main",
    "start:prod": "NODE_ENV=prod node dist/main",

    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",

    "test": "jest test/unit",
    "test:integration": "jest test/integration --runInBand",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand",
    "test:cov": "jest test/unit --coverage",

    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/infra/database/data-source.ts",
    "migration:generate": "pnpm typeorm -- migration:generate",
    "migration:run": "pnpm typeorm -- migration:run",
    "migration:revert": "pnpm typeorm -- migration:revert",
    "migration:show": "pnpm typeorm -- migration:show",

    "seed": "NODE_ENV=dev ts-node -r tsconfig-paths/register src/infra/database/seeders/seed.ts",
    "seed:prod": "ALLOW_PROD_SEED=true NODE_ENV=prod node dist/infra/database/seeders/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.1",
    "amqplib": "^2.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "ioredis": "^5.10.1",
    "joi": "^18.2.9",
    "nanoid": "^6.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.19",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^17.12.0",
    "jest": "^30.4.2",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@main/(.*)$": "<rootDir>/src/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@infra/(.*)$": "<rootDir>/src/infra/$1",
      "^@auth/(.*)$": "<rootDir>/src/modules/00auth/$1",
      "^@user/(.*)$": "<rootDir>/src/modules/00user/$1",
      "^@catalog/(.*)$": "<rootDir>/src/modules/01catalog/$1",
      "^@cart/(.*)$": "<rootDir>/src/modules/02cart/$1",
      "^@order/(.*)$": "<rootDir>/src/modules/03order/$1",
      "^@payment/(.*)$": "<rootDir>/src/modules/04payments/$1",
      "^@identity/(.*)$": "<rootDir>/src/modules/identity/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.e2e-spec\\.ts$"
    ]
  }
}
