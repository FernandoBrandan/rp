{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@infra/(.*)$": "<rootDir>/../src/infra/$1",
    "^@core/(.*)$": "<rootDir>/../src/core/$1",
    "^@application/(.*)$": "<rootDir>/../src/application/$1"
  }
}